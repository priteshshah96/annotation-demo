{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "builds": [
    {
      "src": "src/api/vercel/**/*.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60,
        "maxLambdaSize": "50mb",
        "memory": 1024,
        "nodeVersion": "20.x",
        "includeFiles": [
          "src/lib/**",
          "src/models/**"
        ]
      }
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { 
        "distDir": "dist",
        "zeroConfig": true
      }
    }
  ],
  "rewrites": [
    { "source": "/api/vercel/user/sync", "destination": "/src/api/vercel/user/sync.js" },
    { "source": "/api/vercel/files/upload", "destination": "/src/api/vercel/files/upload.js" },
    { "source": "/api/vercel/files/:fileId", "destination": "/src/api/vercel/files/[fileId].js" },
    { "source": "/api/vercel/files", "destination": "/src/api/vercel/files/index.js" },
    { "source": "/api/vercel/annotations/:fileId/reset", "destination": "/src/api/vercel/annotations/[fileId]/reset.js" },
    { "source": "/api/vercel/annotations/:fileId/sync", "destination": "/src/api/vercel/annotations/[fileId]/sync.js" },
    { "source": "/api/vercel/annotations/:fileId", "destination": "/src/api/vercel/annotations/[fileId].js" },
    { "source": "/api/vercel/annotations", "destination": "/src/api/vercel/annotations/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/vercel/(.*)",
      "headers": [
        {"key": "Access-Control-Allow-Origin", "value": "*"},
        {"key": "Access-Control-Allow-Methods", "value": "GET,POST,PUT,DELETE,OPTIONS"},
        {"key": "Access-Control-Allow-Headers", "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Authorization"},
        {"key": "Access-Control-Allow-Credentials", "value": "true"},
        {"key": "Cache-Control", "value": "no-store, no-cache, must-revalidate"}
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Frame-Options", "value": "DENY"},
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "Permissions-Policy", "value": ""},
        {"key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains"}
      ]
    }
  ],
  "env": {
    "VITE_API_URL": "/api/vercel",
    "NODE_ENV": "production"
  }
}