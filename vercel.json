{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "builds": [
    {
      "src": "src/api/**/*.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60,
        "maxLambdaSize": "50mb",
        "memory": 1024,
        "nodeVersion": "20.x"
      }
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "rewrites": [
    {
      "source": "/api/test",
      "destination": "/src/api/test.js"
    },
    {
      "source": "/api/files/upload",
      "destination": "/src/api/files/upload.js"
    },
    {
      "source": "/api/files/:fileId",
      "destination": "/src/api/files/[fileId].js"
    },
    {
      "source": "/api/files",
      "destination": "/src/api/files/index.js"
    },
    {
      "source": "/api/annotations/:fileId/reset",
      "destination": "/src/api/annotations/[fileId]/reset.js"
    },
    {
      "source": "/api/annotations/:fileId/sync",
      "destination": "/src/api/annotations/[fileId]/sync.js"
    },
    {
      "source": "/api/annotations/:fileId",
      "destination": "/src/api/annotations/[fileId].js"
    },
    {
      "source": "/api/annotations",
      "destination": "/src/api/annotations/index.js"
    },
    {
      "source": "/api/user/sync",
      "destination": "/src/api/user/sync.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {"key": "Access-Control-Allow-Origin", "value": "*"},
        {"key": "Access-Control-Allow-Methods", "value": "GET,POST,PUT,DELETE,OPTIONS"},
        {"key": "Access-Control-Allow-Headers", "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Authorization"},
        {"key": "Access-Control-Allow-Credentials", "value": "true"}
      ]
    }
  ]
}