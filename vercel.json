{
  "version": 2,
  "builds": [
    {
      "src": "src/api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/files/upload",
      "methods": ["POST", "OPTIONS"],
      "dest": "src/api/files/[fileId].js"
    },
    {
      "src": "/api/files/(.*)",
      "methods": ["GET", "DELETE", "OPTIONS"],
      "dest": "src/api/files/[fileId].js"
    },
    {
      "src": "/api/files",
      "methods": ["GET", "OPTIONS"],
      "dest": "src/api/files/[fileId].js"
    },
    {
      "src": "/api/(.*)",
      "dest": "src/api/$1.js"
    }
  ],
  "env": {
    "MONGODB_URI": "@mongodb-uri",
    "CLERK_SECRET_KEY": "@clerk-secret-key"
  }
}