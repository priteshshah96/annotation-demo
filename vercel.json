{
  "version": 2,
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "framework": "vite",
  "rewrites": [
    { 
      "source": "/api/vercel/:path*",
      "destination": "/src/api/vercel/:path*.js"
    },
    { 
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}