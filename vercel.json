{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/api/vercel/health",
      "dest": "src/api/vercel/health/index.js"
    },
    {
      "src": "/api/vercel/user",
      "methods": ["GET", "POST"],
      "dest": "src/api/vercel/user/index.js"
    },
    {
      "src": "/api/vercel/files/upload",
      "methods": ["POST"],
      "dest": "src/api/vercel/files/upload.js"
    },
    {
      "src": "/api/vercel/files",
      "methods": ["GET", "POST"],
      "dest": "src/api/vercel/files/index.js"
    },
    {
      "src": "/api/vercel/annotations/(?<fileId>[^/]+)",
      "methods": ["GET", "PUT", "DELETE"],
      "dest": "src/api/vercel/annotations/[fileId].js"
    },
    {
      "src": "/api/vercel/annotations",
      "methods": ["GET", "POST"],
      "dest": "src/api/vercel/annotations/index.js"
    },
    {
      "src": "/assets/(.*)",
      "headers": { 
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)\\.(?:js|css|svg|ico|jpg|jpeg|png|gif|woff2?)$",
      "headers": { 
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "functions": {
    "src/api/vercel/**/*": {
      "memory": 1024,
      "maxDuration": 10
    }
  }
}